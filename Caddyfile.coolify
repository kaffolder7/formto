{
    auto_https off
    servers {
        # Coolify's proxy supplies the original client address and protocol.
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:80 {
    @backend path /api/* /f/* /health
    handle @backend {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy frontend:80
    }
}
